# =====================================================================
# backend/.env.example
# Copy to .env and set real values before running.
# The server auto-creates the database and applies schema on startup.
# =====================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL connection — the only database used.
# The hospital database is created automatically on first startup.
# No manual psql commands needed unless you want to seed test data.
DATABASE_URL=postgresql://postgres:12345@localhost:5432/hospital

# Set true to skip auto schema-apply on startup (e.g. in CI)
SKIP_DB_INIT=false

# Bootstrap admin account — created on first startup when DB is empty.
# Change immediately after first login in production.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=System Administrator

# JWT — generate strong random values for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-for-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# CORS — comma-separated origins or * for dev
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

LOG_LEVEL=info
